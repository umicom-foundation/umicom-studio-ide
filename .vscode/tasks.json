{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Umicom: Check Windows UCRT64 tools",
      "type": "shell",
      "command": ". '${workspaceFolder}\\scripts\\enter-umicom-ucrt64.ps1'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Configure Windows headless",
      "type": "shell",
      "command": "cmake --preset windows-ucrt64-headless-debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Build Windows headless",
      "type": "shell",
      "command": "cmake --build --preset windows-ucrt64-headless-debug",
      "dependsOn": "Umicom: Configure Windows headless",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Umicom: Test Windows headless",
      "type": "shell",
      "command": "ctest --preset windows-ucrt64-headless-debug",
      "dependsOn": "Umicom: Build Windows headless",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Configure portable headless",
      "type": "shell",
      "command": "cmake --preset headless-debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Build portable headless",
      "type": "shell",
      "command": "cmake --build --preset headless-debug",
      "dependsOn": "Umicom: Configure portable headless",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Umicom: Test portable headless",
      "type": "shell",
      "command": "ctest --preset headless-debug",
      "dependsOn": "Umicom: Build portable headless",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Configure Windows GTK",
      "type": "shell",
      "command": "cmake --preset windows-ucrt64-debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Build Windows GTK",
      "type": "shell",
      "command": "cmake --build --preset windows-ucrt64-debug",
      "dependsOn": "Umicom: Configure Windows GTK",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Umicom: Test Windows GTK",
      "type": "shell",
      "command": "ctest --preset windows-ucrt64-debug",
      "dependsOn": "Umicom: Build Windows GTK",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Run Studio console",
      "type": "shell",
      "command": "& '${workspaceFolder}\\build\\windows-ucrt64-debug\\bin\\umicom-studio-console.exe'",
      "dependsOn": "Umicom: Build Windows GTK",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Run Studio GTK",
      "type": "shell",
      "command": "& '${workspaceFolder}\\build\\windows-ucrt64-debug\\bin\\umicom-studio-ide.exe' --console",
      "dependsOn": "Umicom: Build Windows GTK",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Run Studio doctor",
      "type": "shell",
      "command": "& '${workspaceFolder}\\build\\windows-ucrt64-debug\\bin\\umicom-studio-doctor.exe' '${workspaceFolder}'",
      "dependsOn": "Umicom: Build Windows GTK",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Run Studio diagnostics",
      "type": "shell",
      "command": "& '${workspaceFolder}\\build\\windows-ucrt64-debug\\bin\\umicom-studio-diagnostics.exe' --min info --limit 20 --demo",
      "dependsOn": "Umicom: Build Windows GTK",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: List Studio settings",
      "type": "shell",
      "command": "& '${workspaceFolder}\\build\\windows-ucrt64-debug\\bin\\umicom-studio-settings.exe' --file '${workspaceFolder}\\config\\studio.settings' list",
      "dependsOn": "Umicom: Build Windows GTK",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Umicom: Update dependency lock",
      "type": "shell",
      "command": "& '${workspaceFolder}\\scripts\\update-version-lock.ps1' -RepositoryRoot '${workspaceFolder}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
