{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,

  "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/clang.exe",

  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/windows-ucrt64-debug/compile_commands.json",

  "C_Cpp.default.includePath": [
    "${workspaceFolder}/framework/include",
    "${workspaceFolder}/applications/studio/include",
    "${workspaceFolder}/applications/studio/src/legacy",
    "${workspaceFolder}/applications/studio/src/legacy/**",
    "C:/msys64/ucrt64/include",
    "C:/msys64/ucrt64/include/**"
  ],

  "C_Cpp.default.browse.path": [
    "${workspaceFolder}/framework/include",
    "${workspaceFolder}/applications/studio/include",
    "${workspaceFolder}/applications/studio/src/legacy",
    "C:/msys64/ucrt64/include"
  ],

  "terminal.integrated.env.windows": {
    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
  },

  "files.exclude": {
    "**/build-baseline": true,
    "**/build-ninja": true,
    "**/build": true
  }
}