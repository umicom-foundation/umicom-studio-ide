# =============================================================================
# Umicom Studio IDE and Umicom Framework API documentation
# =============================================================================
PROJECT_NAME           = "Umicom Studio IDE"
PROJECT_NUMBER         = "0.14.0"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

INPUT                  = applications/studio/include \
                         applications/studio/src \
                         framework/include
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES
EXCLUDE                 = applications/studio/src/ui/resources \
                         third_party \
                         build \
                         build-baseline \
                         build-ninja
EXCLUDE_PATTERNS       = */third_party/* */build/*

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
GENERATE_LATEX         = NO

HAVE_DOT               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
QUIET                  = NO
