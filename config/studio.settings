# Umicom Studio IDE typed settings
# Values are validated by Umicom Framework 0.4.4.

studio.ui.theme=system
studio.editor.tab_width=4
studio.editor.insert_spaces=true
studio.workspace.restore_session=true
studio.build.parallel_jobs=4
studio.ai.enabled=true
studio.ai.coding.context_tokens=16384
studio.ai.coding.maximum_patch_files=16
studio.ai.coding.maximum_patch_lines=2000
studio.ai.coding.allow_file_creation=true
studio.ai.coding.allow_file_deletion=false
studio.ai.coding.require_patch_approval=true
studio.diagnostics.capacity=512
studio.files.auto_save=false
studio.files.auto_save_seconds=60
