#include <gtk/gtk.h>
#include "umicom/{{IDENT}}/application.h"

static void activate(GtkApplication *gtk_application, gpointer user_data)
{
    {{IDENT}}Application *application = ({{IDENT}}Application *)user_data;
    GtkWidget *window;
    GtkWidget *box;
    GtkWidget *title;
    GtkWidget *message;

    if ({{IDENT}}_application_create(application) != UMI_STATUS_OK) {
        return;
    }

    if ({{IDENT}}_application_start(application) != UMI_STATUS_OK) {
        return;
    }

    window = gtk_application_window_new(gtk_application);
    gtk_window_set_title(GTK_WINDOW(window), "{{NAME}}");
    gtk_window_set_default_size(GTK_WINDOW(window), 900, 600);

    box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 14);
    gtk_widget_set_margin_top(box, 40);
    gtk_widget_set_margin_start(box, 40);

    title = gtk_label_new("{{NAME}}");
    gtk_widget_add_css_class(title, "title-1");
    message = gtk_label_new("Powered by Umicom Framework");

    gtk_box_append(GTK_BOX(box), title);
    gtk_box_append(GTK_BOX(box), message);
    gtk_window_set_child(GTK_WINDOW(window), box);
    gtk_window_present(GTK_WINDOW(window));
}

int main(int argc, char **argv)
{
    GtkApplication *gtk_application;
    {{IDENT}}Application application = {0};
    int code;

    gtk_application = gtk_application_new(
        "org.umicom.{{IDENT}}",
        G_APPLICATION_DEFAULT_FLAGS
    );

    g_signal_connect(
        gtk_application,
        "activate",
        G_CALLBACK(activate),
        &application
    );

    code = g_application_run(
        G_APPLICATION(gtk_application),
        argc,
        argv
    );

    if (application.master != 0) {
        (void){{IDENT}}_application_stop(&application);
        {{IDENT}}_application_destroy(&application);
    }

    g_object_unref(gtk_application);
    return code;
}
