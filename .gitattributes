# Umicom Studio IDE Git attributes
# Normalize source and documentation so Windows checkouts do not make every
# submodule file appear modified merely because of line-ending conversion.
* text=auto

# Source, build definitions and web/documentation text use LF.
*.c       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.hpp     text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.sh      text eol=lf

# Windows command files use CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Binary formats are never line-ending normalized.
*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.ico  -text
*.pdf  -text
*.docx -text
*.zip  -text
*.7z   -text
*.exe  -text
*.dll  -text
*.lib  -text
*.pdb  -text
*.mp4  -text
*.mov  -text
