{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "headless-debug",
      "displayName": "Portable headless debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "UMICOM_APP_BUILD_GTK": "OFF",
        "UMICOM_APP_BUILD_WEB": "OFF"
      }
    },
    {
      "name": "windows-ucrt64-headless-debug",
      "displayName": "Windows MSYS2 UCRT64 headless debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-headless-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/clang.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "PKG_CONFIG_EXECUTABLE": "C:/msys64/ucrt64/bin/pkg-config.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_TESTING": "ON",
        "UMICOM_APP_BUILD_GTK": "OFF",
        "UMICOM_APP_BUILD_WEB": "OFF"
      }
    },
    {
      "name": "windows-ucrt64-debug",
      "displayName": "Windows MSYS2 UCRT64 GTK4 debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/clang.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "PKG_CONFIG_EXECUTABLE": "C:/msys64/ucrt64/bin/pkg-config.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_TESTING": "ON",
        "UMICOM_APP_BUILD_GTK": "@ENABLE_GTK@",
        "UMICOM_APP_BUILD_WEB": "@ENABLE_WEB@"
      }
    }
  ],
  "buildPresets": [
    {"name": "headless-debug", "configurePreset": "headless-debug"},
    {"name": "windows-ucrt64-headless-debug", "configurePreset": "windows-ucrt64-headless-debug"},
    {"name": "windows-ucrt64-debug", "configurePreset": "windows-ucrt64-debug"}
  ],
  "testPresets": [
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "windows-ucrt64-headless-debug",
      "configurePreset": "windows-ucrt64-headless-debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "windows-ucrt64-debug",
      "configurePreset": "windows-ucrt64-debug",
      "output": {"outputOnFailure": true}
    }
  ]
}
